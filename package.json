{
  "name": "fantasy-map",
  "version": "0.1.0",
  "private": true,
  "description": "Ink fantasy map generator on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --port 8799 --ip 127.0.0.1 --local-upstream 127.0.0.1:8799",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --exclude test/api.test.ts && vitest run test/api.test.ts",
    "build": "node scripts/build.mjs",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260921.0-alpha",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "esm-potrace-wasm": "^0.5.1",
    "tesseract.js": "^7.0.0"
  }
}
