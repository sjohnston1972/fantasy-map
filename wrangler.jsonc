{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-map",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Only /api/* reaches the Worker code; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "maps.clydeford.net", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
